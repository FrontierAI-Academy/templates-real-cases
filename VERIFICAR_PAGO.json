    {
      "parameters": {
        "jsCode": "// Validación de entrada\nif (items.length === 0 || !items[0].json.ia_url || !items[0].json.recent_urls) {\n\treturn [{\n\t\tjson: {\n\t\t\terror: 'Faltan los campos \"ia_url\" o \"recent_urls\".'\n\t\t}\n\t}];\n}\n\n// Función para calcular similitud (distancia de Levenshtein normalizada)\nfunction similarity(a, b) {\n\tconst lengthA = a.length;\n\tconst lengthB = b.length;\n\tconst dp = Array.from({ length: lengthA + 1 }, () => Array(lengthB + 1).fill(0));\n\n\tfor (let i = 0; i <= lengthA; i++) dp[i][0] = i;\n\tfor (let j = 0; j <= lengthB; j++) dp[0][j] = j;\n\n\tfor (let i = 1; i <= lengthA; i++) {\n\t\tfor (let j = 1; j <= lengthB; j++) {\n\t\t\tconst cost = a[i - 1] === b[j - 1] ? 0 : 1;\n\t\t\tdp[i][j] = Math.min(\n\t\t\t\tdp[i - 1][j] + 1,\n\t\t\t\tdp[i][j - 1] + 1,\n\t\t\t\tdp[i - 1][j - 1] + cost\n\t\t\t);\n\t\t}\n\t}\n\n\tconst distance = dp[lengthA][lengthB];\n\tconst maxLen = Math.max(lengthA, lengthB);\n\treturn 1 - distance / maxLen; // Similitud entre 0 y 1\n}\n\n// Extraer los datos\nconst aiUrl = items[0].json.ia_url;\nconst recentUrls = items[0].json.recent_urls;\n\nlet bestMatch = null;\nlet highestScore = 0;\n\n// Comparar cada URL reciente con la generada por la IA\nfor (const url of recentUrls) {\n\tconst score = similarity(aiUrl, url);\n\tif (score > highestScore) {\n\t\thighestScore = score;\n\t\tbestMatch = url;\n\t}\n}\n\n// Resultado final\nreturn [{\n\tjson: {\n\t\toriginal_url: aiUrl,\n\t\tbest_match_url: bestMatch,\n\t\tsimilarity_score: highestScore\n\t}\n}];"
      },
